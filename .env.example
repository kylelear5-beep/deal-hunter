# ============================================================
#  Deal Hunter settings. START-HERE.bat copies this to .env for you.
#  Fill in what you use; leave the rest blank.
# ============================================================

# ---- LLM (required) ----------------------------------------
# Get a free key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests per minute to the LLM (keep at 10 or lower on Gemini's free tier)
LLM_MAX_RPM=10
LLM_MAX_CHARS=12000
# Most posts the AI reads per run (the rest wait for the next run)
MAX_AI_ITEMS_PER_RUN=10

# Optional: any OpenAI-compatible API instead (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---- Alerts (blank = off) ----------------------------------
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Telegram: message @BotFather -> /newbot for the token.
# TELEGRAM_CHAT_ID = YOUR personal chat with the bot (problems + weekly report go here).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Also send high-value deals to your personal chat? (true/false)
PERSONAL_ALERTS=false
ALERT_MIN_DOLLARS=50
ALERT_MIN_PERCENT=50

# ---- Affiliate links (blank = plain links) -----------------
AMAZON_ASSOCIATE_TAG=
EBAY_CAMPAIGN_ID=
EBAY_CUSTOM_ID=dealhunter
# Generic deep-link template for Impact / Rakuten / CJ etc.
# {url} = encoded store link, {subid} = deal id, {domain} = store domain
# Example: https://yourbrand.sjv.io/c/1234567/890/1234?u={url}&subId1={subid}
AFFILIATE_GENERIC_TEMPLATE=
# Different network per store (optional, one line of JSON). {url} {subid} {domain} work here too.
# AFFILIATE_TEMPLATES_JSON={"homedepot.com":"https://homedepot.sjv.io/c/ID/ID/ID?u={url}&subId1={subid}"}
AFFILIATE_TEMPLATES_JSON=
# Only use the generic template for these stores (comma list). Blank = every other store.
AFFILIATE_GENERIC_DOMAINS=
# Stores that get a PLAIN link inside the Chrome extension (check each program's rules)
AFFILIATE_SKIP_IN_EXTENSION=amazon.com

# ---- API ---------------------------------------------------
# Your own all-access key. Make it long and random (START-HERE.bat can generate one).
MASTER_API_KEY=
API_HOST=127.0.0.1
API_PORT=8000
RATE_FREE_PER_DAY=100
RATE_FREE_PER_MINUTE=10
RATE_PRO_PER_DAY=10000
RATE_PRO_PER_MINUTE=120
# true = the API only serves sources listed under commercial_safe_sources in sources.yaml
COMMERCIAL_MODE=false
# Extra allowed web origins (comma list). Chrome extensions are always allowed.
CORS_ORIGINS=

# ---- Reddit (optional; works without it via public JSON) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:deal-hunter:1.0 (by u/your_username)

# ---- Scraping ----------------------------------------------
# Comma list, e.g. http://user:pass@1.2.3.4:8080,http://5.6.7.8:3128
PROXIES=
SCRAPE_MIN_DELAY=2
SCRAPE_MAX_DELAY=5
SCRAPE_MAX_RETRIES=4
RESPECT_ROBOTS=true
HEADLESS=true

# ---- Verifier ----------------------------------------------
VERIFY_ENABLED=true
VERIFY_MAX_PER_STORE_PER_DAY=20
VERIFY_DELETE_AFTER_FAILURES=2

# ---- Loop / storage ----------------------------------------
LOOP_MINUTES=30
DB_PATH=
LOG_LEVEL=INFO
# Docker only: api | loop | all
RUN_MODE=all

# ============================================================
#  AUTOPILOT (v3): channels, website, schedule
# ============================================================
SITE_NAME=Deal Hunter
SITE_CONTACT_EMAIL=
# Public Discord invite link for the website's Join button (NOT a webhook link).
DISCORD_INVITE_URL=
# Free cookie-free visitor counter (pick one, optional).
CLOUDFLARE_ANALYTICS_TOKEN=
GOATCOUNTER_SITE=
# Your website address once deployed (https://yourdomain.com, or http://SERVER-IP:8000)
PUBLIC_BASE_URL=
# Only if you bought a domain and pointed it at the server (turns on automatic HTTPS)
DOMAIN=
TIMEZONE=America/New_York

# Channels per niche (see niche.yaml). Public channels can use @name; private ones need the
# numeric ID (run find-chats.bat). Discord = webhook URL. Blank = not used.
FARM_FREE_TELEGRAM=
FARM_PAID_TELEGRAM=
FARM_FREE_DISCORD=
FARM_PAID_DISCORD=
FARM_PREMIUM_URL=

MOTO_FREE_TELEGRAM=
MOTO_PAID_TELEGRAM=
MOTO_FREE_DISCORD=
MOTO_PAID_DISCORD=
MOTO_PREMIUM_URL=

# Free channels get deals this many minutes after Premium
FREE_DELAY_MINUTES=60
# Price errors go to Premium only; free channel gets a "join Premium" teaser
PAID_EXCLUSIVE_PRICE_ERRORS=true
FREE_TEASERS=true

# Daily digest hour (24h, local time). Weekly Top 10 replaces it on WEEKLY_TOP_DAY (6 = Sunday)
DIGEST_HOUR=18
WEEKLY_TOP_DAY=6
# Your weekly report: REPORT_DAY (0 = Monday) at REPORT_HOUR
REPORT_DAY=0
REPORT_HOUR=9

BACKUP_KEEP=7
WATCHDOG_NO_DEALS_HOURS=6
WATCHDOG_REPEAT_HOURS=6
